TEXT 1200 344 Left 2 !****************************************************\n* CASE 1 - BASELINE\n* Wn = 0.5um, Wp = 1.5um\n* VDD = 2.5V, CL = 5fF, fCLK = 1GHz\n****************************************************\n \n*.param Kcrit=1\n \n*.meas tran tCQ_LH TRIG V(clk) VAL=1.25 RISE=1 TD=0.5n TARG V(q) VAL=1.25 RISE=1 TD=0.5n\n*.meas tran tCQ_HL TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(q) VAL=1.25 FALL=1 TD=2.5n\n*.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n*.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 4n TO 10n\n*.meas tran PDP PARAM Pavg*tCQ\n*.meas tran Ecycle PARAM Pavg*1n
TEXT 2424 304 Left 2 !****************************************************\n* CASE 3 - FINE Kcrit OPTIMIZATION - ACTIVE\n****************************************************\n \n.step param Kcrit list 1.3 1.4 1.5 1.6 1.7 1.8 1.9 2\n \n.meas tran tCQ_LH TRIG V(clk) VAL=1.25 RISE=1 TD=0.5n TARG V(q) VAL=1.25 RISE=1 TD=0.5n\n \n.meas tran tCQ_HL TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(q) VAL=1.25 FALL=1 TD=2.5n\n \n.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n \n.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 4n TO 10n\n \n.meas tran PDP PARAM Pavg*tCQ\n \n.meas tran Ecycle PARAM Pavg*1n\n \n.meas tran tCLK_Y TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(y) VAL=1.25 FALL=1 TD=2.5n\n \n.meas tran tCLK_QBAR TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(qbar) VAL=1.25 RISE=1 TD=2.5n
TEXT 1208 784 Left 2 !****************************************************\n* CASE 2 - COARSE Kcrit SWEEP\n****************************************************\n \n*.step param Kcrit list 1 1.25 1.5 2 2.5 3\n \n*.meas tran tCQ_LH TRIG V(clk) VAL=1.25 RISE=1 TD=0.5n TARG V(q) VAL=1.25 RISE=1 TD=0.5n\n*.meas tran tCQ_HL TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(q) VAL=1.25 FALL=1 TD=2.5n\n*.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n*.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 4n TO 10n\n*.meas tran PDP PARAM Pavg*tCQ
TEXT 656 392 Left 2 !.tran 0 10n 0 1p
TEXT 2416 968 Left 2 !****************************************************\n* CASE 4 - FINAL OPTIMIZED DESIGN\n* Kcrit = 1.8\n****************************************************\n \n*.param Kcrit=1.8\n \n*.meas tran tCQ_LH TRIG V(clk) VAL=1.25 RISE=1 TD=0.5n TARG V(q) VAL=1.25 RISE=1 TD=0.5n\n*.meas tran tCQ_HL TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(q) VAL=1.25 FALL=1 TD=2.5n\n*.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n*.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 4n TO 10n\n*.meas tran PDP PARAM Pavg*tCQ\n*.meas tran Ecycle PARAM Pavg*1n
TEXT 1216 1160 Left 2 !****************************************************\n* CASE 5 - SETUP TIME CHARACTERIZATION\n* Activate Kcrit=1.8 and setup-time D stimulus\n****************************************************\n \n*.param Kcrit=1.8\n \n* D source for setup sweep:\n* PULSE(0 2.5 {5n-Tsu} 20p 20p 1.5n 20n)\n \n*.step param Tsu list -10p -9p -8p -7p -6p -5p -4p -3p -2p -1p 0 10p 20p 30p 40p 50p 60p 80p 100p 120p 150p 200p\n \n*.meas tran tCQ_setup TRIG V(clk) VAL=1.25 RISE=1 TD=4.5n TARG V(q) VAL=1.25 RISE=1 TD=4.5n\n \n*.meas tran Qcheck FIND V(q) AT=5.5n
TEXT 2416 1376 Left 2 !****************************************************\n* CASE 6 - OUTPUT LOAD SWEEP\n****************************************************\n \n*.param Kcrit=1.8\n*.step param CL list 1f 2f 5f 10f 20f 50f\n \n*.meas tran tCQ_LH TRIG V(clk) VAL=1.25 RISE=1 TD=0.5n TARG V(q) VAL=1.25 RISE=1 TD=0.5n\n*.meas tran tCQ_HL TRIG V(clk) VAL=1.25 RISE=1 TD=2.5n TARG V(q) VAL=1.25 FALL=1 TD=2.5n\n*.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n*.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 4n TO 10n\n*.meas tran PDP PARAM Pavg*tCQ
TEXT 656 448 Left 2 !.param CL=5f
TEXT 1216 1624 Left 2 !****************************************************\n* CASE 7 - FREQUENCY CHARACTERIZATION\n****************************************************\n \n*.param Kcrit=1.8\n*.param Tclk={1/Fclk}\n \n*.step param Fclk list 500Meg 750Meg 1G 1.25G 1.5G 2G 2.5G 3G\n \n* CLK:\n* PULSE(0 2.5 0 20p 20p {0.5*Tclk-20p} {Tclk})\n \n* D:\n* PULSE(0 2.5 {0.2*Tclk} 20p 20p {1.8*Tclk} {4*Tclk})\n \n*.meas tran tCQ_LH TRIG V(clk) VAL=1.25 RISE=2 TARG V(q) VAL=1.25 RISE=1\n*.meas tran tCQ_HL TRIG V(clk) VAL=1.25 RISE=4 TARG V(q) VAL=1.25 FALL=1\n*.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n \n*.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 8n TO 24n\n*.meas tran PDP PARAM Pavg*tCQ\n \n*.meas tran Qmax MAX V(q) FROM 8n TO 24n\n*.meas tran Qmin MIN V(q) FROM 8n TO 24n
TEXT 1216 2328 Left 2 !*.tran 0 32n 0 1p
TEXT 2416 1752 Left 2 !****************************************************\n* CASE 8 - SUPPLY VOLTAGE CHARACTERIZATION\n****************************************************\n \n*.param Kcrit=1.8\n*.step param VDDX list 2.0 2.25 2.5 2.75\n \n* Supply value:\n* {VDDX}\n \n* CLK:\n* PULSE(0 {VDDX} 0 20p 20p 480p 1n)\n \n* D:\n* PULSE(0 {VDDX} 200p 20p 20p 1.8n 4n)\n \n*.meas tran tCQ_LH TRIG V(clk)-0.5*V(vdd) VAL=0 RISE=1 TD=0.5n TARG V(q)-0.5*V(vdd) VAL=0 RISE=1 TD=0.5n\n \n*.meas tran tCQ_HL TRIG V(clk)-0.5*V(vdd) VAL=0 RISE=1 TD=2.5n TARG V(q)-0.5*V(vdd) VAL=0 FALL=1 TD=2.5n\n \n*.meas tran tCQ PARAM max(tCQ_LH,tCQ_HL)\n*.meas tran Pavg AVG (-V(vdd)*I(VDD)) FROM 8n TO 24n\n*.meas tran PDP PARAM Pavg*tCQ\n*.meas tran Qmax MAX V(q) FROM 8n TO 24n\n*.meas tran Qmin MIN V(q) FROM 8n TO 24n
TEXT 384 560 Left 2 ;****************************************************\n* SIMULATION CASES\n* Only CASE 3 - Fine Kcrit Sweep is active.\n* To reproduce another experiment:\n* 1. Disable the active .step/.meas block.\n* 2. Enable the desired CASE block.\n* 3. Use the corresponding source values indicated\n*    inside that block.\n****************************************************
TEXT 656 496 Left 2 !.param VDDX 2.5V
